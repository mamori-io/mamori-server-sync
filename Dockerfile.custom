FROM mamori-api-runner

# Add lodash and moment libraries (included by default)
RUN yarn add lodash moment

# Add type definitions for TypeScript support
RUN yarn add --dev @types/lodash

# mamori-ent-js-sdk: sync uses MamoriService.disable_user / enable_user for user state reconcile.
# If the base image ships an older SDK without enable_user, upgrade the package, e.g.:
# RUN yarn add mamori-ent-js-sdk@latest

# Add your custom libraries here:
# RUN yarn add axios fs-extra uuid
# RUN yarn add --dev @types/uuid

# Example: Adding a specific version
# RUN yarn add lodash@4.17.21 moment@2.29.4
