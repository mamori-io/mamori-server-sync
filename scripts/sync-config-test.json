{
  "sync_settings": {
    "description": "Test configuration for Mamori sync operations. Set to 1 to sync, 0 to skip.",
    "version": "1.0"
  },
  "sync_objects": {
    "directory_users": 1,
    "mamori_users": 1,
    "alert_channels": 0,
    "connection_policies_before": 0,
    "connection_policies_after": 0,
    "ip_resources": 0,
    "remote_desktop_logins": 0,
    "http_resources": 0,
    "secrets": 0,
    "datasources": 1,
    "datasource_credentials": 1,
    "ssh_logins": 0,
    "requestable_resources": 0,
    "roles": 0,
    "role_grants": 0,
    "role_permissions": 0,
    "on_demand_policies": 0
  },
  "sync_options": {
    "create_new": true,
    "update_existing": true,
    "delete_removed": true,
    "batch_size": 1000,
    "log_level": "info",
    "test_mode": true,
    "test_limit": 3
  },
  "sync_actions": {
    "sync-mamori-user-password": 0,
    "sync-mamori-user-mfa": 0,
    "sync-directory-user_mfa": 0
  },
  "provider_mappings": [
    {
      "source_provider": "ad_sandbox",
      "target_provider": "demo_ad"
    }
  ],
  "object_filters": {
    "mamori_users": [
      "^om01$",
      "^om02$",
      "^om03$"
    ],
    "directory_users": [
      "^omasri$"
    ],
    "datasources": [
      "^oracle193$"
    ]
  }
}
